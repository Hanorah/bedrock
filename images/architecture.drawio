<mxfile host="app.diagrams.net" agent="claude" version="24.0.0">
  <diagram name="Bedrock Spend Sentinel" id="spend-sentinel-arch">
    <mxGraphModel dx="1200" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- AWS Cloud boundary -->
        <mxCell id="cloud" value="AWS Cloud &#10;us-east-1" style="sketch=0;outlineConnect=0;html=1;whiteSpace=wrap;fillColor=none;verticalAlign=top;align=left;spacingLeft=34;fontColor=#232F3E;fontSize=13;fontStyle=1;dashed=1;dashPattern=8 4;strokeColor=#232F3E;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;" vertex="1" parent="1">
          <mxGeometry x="140" y="40" width="640" height="380" as="geometry" />
        </mxCell>

        <!-- Row 1: ingestion path -->
        <mxCell id="proxy" value="spend-sentinel-proxy" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="210" y="110" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="proxy_sub" value="Proxy Lambda" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#5A6B7B;" vertex="1" parent="1">
          <mxGeometry x="190" y="180" width="108" height="20" as="geometry" />
        </mxCell>

        <mxCell id="ddb" value="spend-sentinel-usage" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#3334B9;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1">
          <mxGeometry x="410" y="110" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="ddb_sub" value="DynamoDB usage table" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#5A6B7B;" vertex="1" parent="1">
          <mxGeometry x="380" y="180" width="128" height="20" as="geometry" />
        </mxCell>

        <mxCell id="bedrock1" value="Amazon Bedrock" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1">
          <mxGeometry x="610" y="110" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="bedrock1_sub" value="converse API" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#5A6B7B;" vertex="1" parent="1">
          <mxGeometry x="590" y="180" width="108" height="20" as="geometry" />
        </mxCell>

        <!-- Row 2: aggregation path -->
        <mxCell id="eventbridge" value="spend-sentinel-schedule" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.eventbridge;" vertex="1" parent="1">
          <mxGeometry x="210" y="300" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="eventbridge_sub" value="EventBridge, every 15 min" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#5A6B7B;" vertex="1" parent="1">
          <mxGeometry x="180" y="370" width="128" height="20" as="geometry" />
        </mxCell>

        <mxCell id="aggregator" value="spend-sentinel-aggregator" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1">
          <mxGeometry x="410" y="300" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="aggregator_sub" value="Aggregator Lambda" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#5A6B7B;" vertex="1" parent="1">
          <mxGeometry x="380" y="370" width="128" height="20" as="geometry" />
        </mxCell>

        <mxCell id="sns" value="spend-sentinel-alerts" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_notification_service;" vertex="1" parent="1">
          <mxGeometry x="610" y="300" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="sns_sub" value="SNS topic" style="text;html=1;align=center;verticalAlign=top;fontSize=11;fontColor=#5A6B7B;" vertex="1" parent="1">
          <mxGeometry x="590" y="370" width="108" height="20" as="geometry" />
        </mxCell>

        <!-- External actors -->
        <mxCell id="teamapps" value="Team apps&#10;(growth, rise, fall)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#232F3E;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="10" y="120" width="110" height="50" as="geometry" />
        </mxCell>

        <mxCell id="notify" value="Email / Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1EFE8;strokeColor=#888780;fontColor=#232F3E;fontSize=12;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="820" y="310" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;" edge="1" parent="1" source="teamapps" target="proxy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="invoke" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;" edge="1" parent="1" source="proxy" target="bedrock1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="log usage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;" edge="1" parent="1" source="proxy" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;" edge="1" parent="1" source="eventbridge" target="aggregator">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="query spend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="aggregator" target="ddb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="draft summary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;exitX=1;exitY=0.5;entryX=1;entryY=1;" edge="1" parent="1" source="aggregator" target="bedrock1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="644" y="410" />
              <mxPoint x="644" y="264" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="publish, only if over threshold" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;" edge="1" parent="1" source="aggregator" target="sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;fontColor=#5A6B7B;strokeColor=#5A6B7B;" edge="1" parent="1" source="sns" target="notify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
